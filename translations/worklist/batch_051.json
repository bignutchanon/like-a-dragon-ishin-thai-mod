 "strings": {
  "じょうし": "",
  "よく喋ること。": "",
  "饒舌": "",
  "じょうぜつ": "",
  "宿で給仕などを行う女性のこと。": "",
  "女中": "",
  "じょちゅう": "",
  "知らなければ平静な心でいられる\nということのたとえ。": "",
  "知らぬが仏": "",
  "しらぬがほとけ": "",
  "しらふだごうし": "",
  "忠節を尽くし、国から受けた恩に報いること。": "",
  "尽忠報国": "",
  "じんちゅうほうこく": "",
  "日本の剣術流派。": "",
  "心道無念流": "",
  "しんとうむねんりゅう": "",
  "せきがはら": "",
  "自分のことをへりくだって表現した言葉。": "",
  "拙者": "",
  "せっしゃ": "",
  "せっぷく": "",
  "そうけ": "",
  "君主ないし領主に代わって任地の事務を司る人。": "",
  "代官": "",
  "だいかん": "",
  "だっぱん": "",
  "たぬきうどん": "",
  "ちょうしゅうはん": "",
  "天皇が政治を行う場所。機関。": "",
  "朝廷": "",
  "ちょうてい": "",
  "帝から発せられた命令のこと。": "",
  "勅命": "",
  "ちょくめい": "",
  "つきみうどん": "",
  "店でその場の支払いをせず\n後日に支払いをまわすこと。": "",
  "ツケ": "",
  "つけ": "",
  "つじぎり": "",
  "学問を教える場所。民間の学校のようなもの。\n武士や医者などを中心に、町の子供たちを対象に、\n算盤（そろばん）などを教育する。": "",
  "寺子屋": "",
  "てらこや": "",
  "城に建てられた象徴的な建造物の名称。": "",
  "天守": "",
  "てんしゅ": "",
  "“天地の神々・すべての神々”という意味。": "",
  "天地神明": "",
  "てんちしんめい": "",
  "てんちゅう": "",
  "どうしん": "",
  "床あしらいが上手なこと。\n性的な技術にすぐれていること。": "",
  "床上手": "",
  "とこじょうず": "",
  "とさ": "",
  "とさきんのうとう": "",
  "手に何も武器を持たずに戦うこと。": "",
  "徒手空拳": "",
  "としゅくうけん": "",
  "泥や漆喰で囲った倉庫。": "",
  "土蔵": "",
  "どぞう": "",
  "家屋内にあって床板を敷かずに地面のままか、\n漆喰を塗り固めた床にした空間。": "",
  "土間": "",
  "どま": "",
  "崩壊・破綻寸前の組織。": "",
  "泥舟": "",
  "どろふね": "",
  "駐在所のこと。": "",
  "屯所": "",
  "とんしょ": "",
  "なんばん": "",
  "南無阿弥陀仏（なむあみだぶつ）。\n亡くなった人に対しての唱え文句。": "",
  "ナンマンダブ": "",
  "なんまんだぶ": "",
  "物を焼くことで煙を上げ、\nそれを離れたところから確認することによって、\n情報を伝達する手段。": "",
  "狼煙": "",
  "のろし": "",
  "賭博を仕事として生きる者の呼び名。": "",
  "博徒": "",
  "ばくと": "",
  "ばくふ": "",
  "はたもと": "",
  "掟、法のこと。": "",
  "法度": "",
  "はっと": "",
  "草履についている紐のこと。": "",
  "鼻緒": "",
  "はなお": "",
  "鎌倉時代から江戸時代まで、\n書簡や小貨物などを運搬する人。": "",
  "飛脚": "",
  "ひきゃく": "",
  "ひっとう": "",
  "ふしみ": "",
  "学芸と武芸両方優れていること。": "",
  "文武両道": "",
  "ぶんぶりょうどう": "",
  "長い棒を武器とする戦闘技術。": "",
  "棒術": "",
  "ぼうじゅつ": "",
  "ぼんおどり": "",
  "江戸時代において戸籍を外された人。\n住む家が無い人。": "",
  "無宿": "",
  "むしゅく": "",
  "武術や芸道など、師匠が弟子に全て残らず伝え、\nその修了を認めること。": "",
  "免許皆伝": "",
  "めんきょかいでん": "",
  "急性虫垂炎のこと、急に激しい腹痛をもたらす病気。": "",
  "盲腸": "",
  "もうちょう": "",
  "揚屋等、遊女が在籍する店が\n集まっている場所のこと。": "",
  "遊郭": "",
  "ゆうかく": "",
  "遊郭内にある揚屋に在籍する女の総称。": "",
  "遊女": "",
  "ゆうじょ": "",
  "何か不吉なことが起こりそうな\nあやしい雰囲気や気配を漂わせている刀。": "",
  "妖刀": "",
  "ようとう": "",
  "生活に必要な種々のこまごまとした\n日用品を売る店。": "",
  "万屋": "",
  "よろずや": "",
  "らくがい": "",
  "らくない": "",
  "らんぽうい": "",
  "藩（国や地域組織）の役職。渉外担当。": "",
  "留守居役": "",
  "るすいやく": "",
  "主家を離れた武士。仕える主人のない武士。浪人。": "",
  "浪士": "",
  "ろうし": "",
  "ろうにん": "",
  "かんぬし": "",
  "みこ": "",
  "きょう": "",
  "ええじゃないか": "",
  "こだ": "",
  "おおだち": "",
  "もん／りょう": "",
  "すん／しゃく": "",
  "へやずみ": "",
  "せんごくじだい": "",
  "どすこい": "",
  "いしん": "",
  "たいろう": "",
  "ふんどし": "",
  "ぶよう": "",
  "いざかや": "",
  "さっちょう": "",
  "どうじょう": "",
  "こばん": "",
  "りょうてい": "",
  "はおり": "",
  "下っ端な者を指す。\nばくちでサイコロの出目が三より下の場合、\nほぼ勝ち目がないことからきた言葉。": "",
  "三下": "",
  "さんした": "",
  "江戸時代までの日本における契約書のこと。\n特に金銭貸借において、\n債務承認の書面を証文と読んだ。": "",
  "証文": "",
  "しょうもん": "",
  "ある地域を一人の権力者が支配すること。": "",
  "天下統一": "",
  "てんかとういつ": "",
  "天下を取るか取られるかの分かれ目のこと。\n勝敗が決まる重要な分かれ目。": "",
  "天下分け目": "",
  "てんかわけめ": "",
  "うらが": "",
  "帝などの君主が直接発行する公的な認可。": "",
  "勅許": "",
  "ちょっきょ": "",
  "ひとつばしは": "",
  "なんきは": "",
  "みとはん": "",
  "主君を中心とした人間関係から疎遠の関係にある家臣。\nまた主君と緩い主従関係にある家臣のこと。\n江戸時代では関ヶ原の戦い以降に\n徳川家に仕えた大名を外様大名という。": "",
  "外様": "",
  "とざま": "",
  "組織内部にいて、\nその組織に害をもたらす者、恩を仇で返す者。": "",
  "獅子身中の虫": "",
  "しししんちゅうのむし": "",
  "帝の命令が書かれてある文章。": "",
  "勅書": "",
  "ちょくしょ": "",
  "とくがわござんけ": "",
  "斬首された罪人の生首を、\n牢獄の門などに晒す刑罰。": "",
  "獄門": "",
  "ごくもん": "",
  "さくらだもん": "",
  "あいづはん": "",
  "ちょうそかべ": "",
  "仕事や勉強など全力を尽くしてまじめに励むこと。": "",
  "精励恪勤": "",
  "せいれいかっきん": "",
  "てぐすいと": "",
  "よしわらゆうかく": "",
